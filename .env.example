# ===== WebDAV 云备份（部署时预设，全部可选项）=====
# 用户仍可在应用「我的 → WebDAV 云备份」里查看/覆盖（保存在浏览器本地）

# WebDAV 服务器根地址
VITE_WEBDAV_URL=https://dav.jianguoyun.com/dav/

# WebDAV 账号
VITE_WEBDAV_USERNAME=

# WebDAV 密码（建议用坚果云「应用密码」等应用专用密码；注意：打包进前端即视为公开信息）
VITE_WEBDAV_PASSWORD=

# 远端目录（默认 warmweight）
VITE_WEBDAV_DIR=warmweight

# 部署后默认开启自动备份：true / false（默认 false）
VITE_WEBDAV_ENABLED=true

# 默认连接方式：proxy（默认，走 /api/webdav 代理，无跨域限制）或 direct（直连，要求服务器开 CORS）
VITE_WEBDAV_MODE=proxy
